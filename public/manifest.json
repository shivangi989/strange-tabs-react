{
  "manifest_version": 3,
  "name": "Strange Tabs React",
  "version": "1.0",
  "description": "Master your tabs with the power of the Sorcerer Supreme.",
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon(16-16).png",
      "48": "icons/icon(48-48).png",
      "128": "icons/icon(128-128).png"
    }
  },
  "icons": {
      "16": "icons/icon(16-16).png",
      "48": "icons/icon(48-48).png",
      "128": "icons/icon(128-128).png"
  },
  "permissions": ["tabs", "storage","activeTab","tabGroups"]
}